<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  com.jimmy.wealthsync — 每天 14:30(台北)由本機觸發 wealth_sync.yml

  這份是「版控用的母本」,實際生效的是 ~/Library/LaunchAgents/ 下的副本。

  ⚠ 腳本也必須安裝到 ~/Library/Application Support/wealth-sync/,不能直接指向
    repo 裡的 jimmy_scripts/：launchd 叫起的程序受 macOS TCC 限制,讀不到
    ~/Downloads 底下任何檔案(實測 `Operation not permitted`)。

  安裝(改完 plist 或 trigger_wealth_sync.sh 都要重跑一次):
    mkdir -p ~/Library/LaunchAgents "$HOME/Library/Application Support/wealth-sync"
    cp jimmy_scripts/trigger_wealth_sync.sh "$HOME/Library/Application Support/wealth-sync/"
    chmod +x "$HOME/Library/Application Support/wealth-sync/trigger_wealth_sync.sh"
    cp jimmy_scripts/com.jimmy.wealthsync.plist ~/Library/LaunchAgents/
    launchctl bootout  gui/$(id -u)/com.jimmy.wealthsync 2>/dev/null
    launchctl bootstrap gui/$(id -u) ~/Library/LaunchAgents/com.jimmy.wealthsync.plist
  確認已載入:
    launchctl print gui/$(id -u)/com.jimmy.wealthsync | head -20
  立刻跑一次(測試用):
    launchctl kickstart -p gui/$(id -u)/com.jimmy.wealthsync
  卸載:
    launchctl bootout gui/$(id -u)/com.jimmy.wealthsync
    rm ~/Library/LaunchAgents/com.jimmy.wealthsync.plist

  時間為什麼挑 14:30:台股 13:30 收盤,TWSE 收盤資料通常 14:00~14:30 之間上架。
  腳本本身會重試最多 6 次 x 10 分鐘,所以就算 TWSE 晚上架也等得到(最晚約 15:30)。
  Mac 在 14:30 處於睡眠時,launchd 會在喚醒後補跑這一次;**完全關機那天 launchd
  不會補跑**,改由 RunAtLoad 在下次登入時叫起腳本補跑(見下方 RunAtLoad 說明)。
  兩者都沒成功時,GitHub cron 仍是最後一道備援(晚幾小時,就是改用 launchd 之前的現狀)。
  日誌:~/Library/Logs/wealth_sync_trigger.log
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.jimmy.wealthsync</string>

    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <!-- 不可指向 ~/Downloads：launchd 受 TCC 限制讀不到那裡(見檔頭) -->
        <string>/Users/jimmy/Library/Application Support/wealth-sync/trigger_wealth_sync.sh</string>
    </array>

    <key>StartCalendarInterval</key>
    <dict>
        <key>Hour</key>
        <integer>14</integer>
        <key>Minute</key>
        <integer>30</integer>
    </dict>

    <!--
      開機/登入後自動補跑(2026-10-28 起由 false 改為 true)

      為什麼需要:StartCalendarInterval 在「睡眠中錯過排定時間」會於喚醒後補跑,
      但「14:30 當下完全關機」那一天**不會**補跑(2026-10-27 實測 runs=0,
      當天的資料全靠人工觸發才補上)。RunAtLoad 讓每次登入都叫起腳本一次,
      由腳本自己決定要不要補。

      為什麼這樣不會重複觸發:腳本第 0 節有時間閘——早於 14:30 一律安靜結束
      (所以平常早上開機只是空跑一瞬),晚於 14:30 才當補跑;再加上既有的
      週末跳過、TWSE 當日無收盤資料跳過、今天已有成功執行就不重複觸發,
      同一天被叫起幾次結果都一樣。不需要任何狀態檔。
    -->
    <key>RunAtLoad</key>
    <true/>

    <key>StandardOutPath</key>
    <string>/Users/jimmy/Library/Logs/wealth_sync_trigger.out.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/jimmy/Library/Logs/wealth_sync_trigger.err.log</string>

    <key>EnvironmentVariables</key>
    <dict>
        <!-- launchd 不繼承登入 shell 的 PATH,curl/date/seq 都在這兩個目錄 -->
        <key>PATH</key>
        <string>/usr/bin:/bin:/usr/sbin:/sbin</string>
    </dict>

    <!-- 腳本最長會跑約 60 分鐘(等 TWSE 資料上架的重試),給足夠餘裕 -->
    <key>ExitTimeOut</key>
    <integer>4200</integer>
</dict>
</plist>
