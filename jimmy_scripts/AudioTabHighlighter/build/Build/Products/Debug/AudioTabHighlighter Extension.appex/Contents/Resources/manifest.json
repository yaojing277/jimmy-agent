{
  "manifest_version": 3,
  "name": "Audio Tab Highlighter",
  "version": "1.1",
  "description": "將正在播放聲音的分頁 Favicon 改為藍色喇叭，方便辨識",

  "permissions": [
    "tabs",
    "scripting"
  ],

  "host_permissions": [
    "<all_urls>"
  ],

  "background": {
    "service_worker": "background.js"
  },

  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],

  "icons": {
    "48": "images/icon-48.png",
    "96": "images/icon-96.png"
  }
}
